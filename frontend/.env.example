# NeverQ Frontend Environment Configuration

# Backend API URL (for production on Render, e.g., https://neverq-api.onrender.com/api)
VITE_API_URL=http://localhost:4000/api

# Realtime WebSocket URL (for production on Render, e.g., https://neverq-api.onrender.com)
VITE_SOCKET_URL=http://localhost:4000

# Set to "false" to connect to real backend API and WebSockets.
# Defaults to true (in-memory mock adapter) when unset.
VITE_USE_MOCK=true

# OpenFreeMap / MapLibre style URLs
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
