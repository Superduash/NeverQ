# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neverq?retryWrites=true&w=majority

# Auth secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=changeme_generate_64_random_hex_chars_for_production_neverq
STAFF_JWT_EXPIRES_IN=12h
ADMIN_JWT_EXPIRES_IN=8h

# Admin & staff credentials (change before deploy)
ADMIN_PASSWORD=admin1234
SEED_STAFF_PIN=1234

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
JOIN_RATE_LIMIT_MAX=8

# Arrival radius in meters (spec: 300m + GPS accuracy capped at 100m)
ARRIVAL_RADIUS_M=300
ARRIVAL_ACCURACY_CAP_M=100

# OpenRouteService (optional, fallbacks to pure estimate when false or unset)
ORS_ENABLED=false
ORS_API_KEY=

# Demo mode & single-origin static serving
DEMO_MODE=true
SERVE_STATIC=false
