PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neverq?retryWrites=true&w=majority

# Auth secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=changeme_generate_64_random_hex_chars
STAFF_JWT_EXPIRES_IN=8h
ADMIN_JWT_EXPIRES_IN=12h

# Admin password (change before deploy)
ADMIN_PASSWORD=admin1234

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
JOIN_RATE_LIMIT_MAX=5

# Arrival radius in meters (spec: 300m + GPS accuracy capped 100m)
ARRIVAL_RADIUS_M=300
ARRIVAL_ACCURACY_CAP_M=100

# Demo Director (set to false in production)
DEMO_MODE=true
